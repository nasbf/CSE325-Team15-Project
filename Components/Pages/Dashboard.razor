@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

@page "/dashboard"

<PageTitle>Your kitchen — Recipefy</PageTitle>

<main class="app-shell" id="home">
    <aside class="sidebar">
        <Brand Class="brand" IconName="CookingPot" IconSize="21" StrokeWidth="2.2" />
        <div class="side-label">YOUR KITCHEN</div>
        <nav class="side-nav" aria-label="Main navigation">
            <a class="nav-item active" href="/dashboard" aria-label="Overview"><Icon Name="LayoutDashboard" Size="18" StrokeWidth="1.8" /><span>Overview</span></a>
            <a class="nav-item" href="/dashboard" aria-label="My recipes"><Icon Name="BookOpen" Size="18" StrokeWidth="1.8" /><span>My recipes</span><span class="nav-count">24</span></a>
            <a class="nav-item" href="/dashboard" aria-label="Meal planner"><Icon Name="CalendarDays" Size="18" StrokeWidth="1.8" /><span>Meal planner</span></a>
            <a class="nav-item" href="/dashboard" aria-label="Collections"><Icon Name="Bookmark" Size="18" StrokeWidth="1.8" /><span>Collections</span></a>
        </nav>
        <div class="side-label collections-label">YOUR COLLECTIONS <button type="button" aria-label="Add collection" class="tiny-add"><Icon Name="Plus" Size="15" /></button></div>
        <a class="collection-item" href="/dashboard" aria-label="Weeknight wins"><span class="collection-dot dot-orange"></span>Weeknight wins</a>
        <a class="collection-item" href="/dashboard" aria-label="Fresh and green"><span class="collection-dot dot-green"></span>Fresh &amp; green</a>
        <a class="collection-item" href="/dashboard" aria-label="Sweet things"><span class="collection-dot dot-pink"></span>Sweet things</a>
        <div class="sidebar-spacer"></div>
        <div class="weekly-card">
            <div class="weekly-icon"><Icon Name="Sparkles" Size="16" /></div>
            <p class="weekly-title">A little inspiration?</p>
            <p class="weekly-copy">Get a fresh meal idea every week.</p>
            <a href="/dashboard">Explore ideas <span>↗</span></a>
        </div>
        <a class="profile-row" href="/"><span class="avatar">@userName[0].ToString().ToUpper()</span><span class="profile-copy"><strong>@userName</strong><small>Home cook</small></span><Icon Name="Ellipsis" Size="18" /></a>
    </aside>

    <section class="main-area">
        <header class="topbar">
            <div class="breadcrumb">Your kitchen <span>/</span> <strong>Overview</strong></div>
            <div class="top-actions">
                <button type="button" class="icon-action" aria-label="Notifications"><Icon Name="Bell" Size="18" /><i></i></button>
                <button type="button" class="help-button"><Icon Name="CircleHelp" Size="16" /> Help</button>
                <span class="top-avatar">@userName[0].ToString().ToUpper()</span>
            </div>
        </header>
        <div class="content-wrap">
            <section class="welcome-row">
                <div>
                    <div class="eyebrow"><Icon Name="Sparkles" Size="13" /> TUESDAY, MAY 21, 2024</div>
                    <h1>Good morning, @userName</h1>
                    <p class="welcome-sub">Something delicious is always within reach.</p>
                </div>
                <a class="primary-button" href="/recipes/new"><Icon Name="Plus" Size="17" /> Add a recipe</a>
            </section>

            <section class="hero-card">
                <div class="hero-copy">
                    <span class="hero-kicker"><Icon Name="Sparkles" Size="14" /> THIS WEEK'S LITTLE NUDGE</span>
                    <h2>Make room for<br />something <em>lovely.</em></h2>
                    <p>Try one new thing this week. A bright, lemony dinner perhaps?</p>
                    <a class="hero-button" href="/recipes/lemon-ricotta-pasta">Find your next favorite <span>→</span></a>
                </div>
                <div class="hero-image">
                    <img src="/recipes/hero-pasta.png" alt="Lemon ricotta pasta with tomatoes and fresh basil" />
                    <div class="image-caption"><span class="caption-star"><Icon Name="Star" Size="14" Fill="currentColor" /></span><span><b>A fresh take on a classic</b><small>Bright, simple, so very good.</small></span></div>
                </div>
            </section>

            <section class="stats-row" aria-label="Your kitchen at a glance">
                <div class="stat-block"><span class="stat-icon green-bg"><Icon Name="BookOpen" Size="17" /></span><span><strong>24</strong><small>saved recipes</small></span></div>
                <span class="stat-divider"></span>
                <div class="stat-block"><span class="stat-icon orange-bg"><Icon Name="CookingPot" Size="17" /></span><span><strong>8</strong><small>cooked this month</small></span></div>
                <span class="stat-divider"></span>
                <div class="stat-block"><span class="stat-icon cream-bg"><Icon Name="Users" Size="17" /></span><span><strong>3</strong><small>meal plans shared</small></span></div>
                <a class="stats-link" href="/dashboard">View your kitchen <span>→</span></a>
            </section>

            <section class="recipes-section">
                <div class="section-heading">
                    <div><div class="eyebrow section-eyebrow">A FEW GOOD THINGS</div><h2>Recipes to make on repeat</h2></div>
                    <a class="text-link" href="/dashboard">See all recipes <span>→</span></a>
                </div>
                <div class="toolbar">
                    <div class="category-tabs" role="tablist" aria-label="Filter by category">
                        @foreach (var category in Categories)
                        {
                            <button type="button" role="tab" aria-selected="@(category == Categories[0])" class="@(category == Categories[0] ? "selected" : null)">@category</button>
                        }
                    </div>
                    <div class="tool-actions">
                        <label class="search-box"><Icon Name="Search" Size="16" /><input aria-label="Search recipes" placeholder="Find a recipe..." /></label>
                        <button type="button" class="filter-button"><Icon Name="SlidersHorizontal" Size="15" /><span>Favorites</span></button>
                        <button type="button" class="sort-button" aria-label="Sort recipes"><Icon Name="ArrowDownUp" Size="16" /></button>
                    </div>
                </div>
                <div class="recipe-grid">
                    @foreach (var recipe in MockRecipes.All)
                    {
                        <RecipeCard Recipe="recipe" />
                    }
                </div>
            </section>

            <footer class="page-footer"><span>Made with care, and a little extra olive oil.</span><span>RECIPEFY <span class="brand-period">.</span> YOUR KITCHEN, YOUR WAY</span></footer>
        </div>
    </section>
</main>

@code {
    private static readonly string[] Categories = ["All recipes", "Breakfast", "Lunch", "Dinner", "Dessert"];
    private string userName = "Alex"; // Default name in case user is not authenticated

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            userName = user.Identity.Name ?? "Alex";
        }
    }

}
