@using Recipefy.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@inject NavigationManager Navigation
@inject SignInManager<IdentityUser> SignInManager



<main class="auth-page">
    <div class="auth-top">
        <Brand Class="auth-brand" IconName="CookingPot" />
        <a class="auth-back" href="/"><Icon Name="ArrowLeft" Size="15" /> Back to your kitchen</a>
    </div>
    <div class="auth-layout">
        <section class="auth-form-panel">
            <div class="auth-form-inner">
                <span class="auth-kicker"><Icon Name="Sparkles" Size="14" /> A FRESH START, EVERY DAY</span>
                <h1>@(IsSignUp ? "Make yourself at home." : "Welcome back.")</h1>
                <p class="auth-intro">@(IsSignUp ? "Your favorite recipes, right where you left them." : "Pull up a chair. Your kitchen is right here.")</p>
                @* Mock only: no authentication yet, so the form's primary action just navigates to the dashboard. *@
                @if (IsSignUp)
                {
                    <EditForm Model="registerModel"
                            OnValidSubmit="RegisterUser"
                            FormName="SignUpForm"
                            class="auth-form">

                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <p class="text-danger">@errorMessage</p>
                        }

                        <label class="auth-field">
                            <span>Your name</span>
                            <InputText @bind-Value="registerModel.Username"
                                    autocomplete="name"
                                    placeholder="How should we call you?" />
                            <ValidationMessage For="@(() => registerModel.Username)" />
                        </label>

                        <label class="auth-field">
                            <span>Email address</span>
                            <span class="auth-input-wrap">
                                <Icon Name="Mail" Size="16" />
                                <InputText @bind-Value="registerModel.Email"
                                        autocomplete="email"
                                        type="email"
                                        placeholder="you@example.com" />
                            </span>
                            <ValidationMessage For="@(() => registerModel.Email)" />
                        </label>

                        <label class="auth-field">
                            <span>Password</span>
                            <span class="auth-input-wrap">
                                <Icon Name="LockKeyhole" Size="16" />
                                <InputText @bind-Value="registerModel.Password"
                                        autocomplete="new-password"
                                        type="password"
                                        placeholder="At least 6 characters" />
                            </span>
                            <ValidationMessage For="@(() => registerModel.Password)" />
                        </label>

                        <label class="auth-field">
                            <span>Confirm password</span>
                            <InputText @bind-Value="registerModel.ConfirmPassword"
                                    type="password"
                                    placeholder="Repeat your password" />
                            <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
                        </label>

                        <button class="auth-submit" type="submit">
                            Create your account
                            <Icon Name="ArrowRight" Size="16" />
                        </button>

                    </EditForm>
                }
                
                else

                {
                    <EditForm Model="loginModel"
                            OnValidSubmit="LoginUser"
                            FormName="SignInForm"
                            class="auth-form">

                        <DataAnnotationsValidator />

                        
                            <label class="auth-field">
                                <span>Email address</span>
                                <span class="auth-input-wrap">
                                    <Icon Name="Mail" Size="16" />
                                    <InputText @bind-Value="loginModel.Email"
                                    autocomplete="email"
                                    type="email"
                                    placeholder="you@example.com" />
                            <ValidationMessage For="@(() => loginModel.Email)" />
                                </span>
                            </label>

                            <label class="auth-field">
                                <span>Password</span>
                                <span class="auth-input-wrap">
                                    <Icon Name="LockKeyhole" Size="16" />
                                    <InputText @bind-Value="loginModel.Password"
                                            autocomplete="current-password"
                                            type="password"
                                            placeholder="Enter your password" />
                                    <ValidationMessage For="@(() => loginModel.Password)" />
                                </span>
                            </label>
                            @if (!string.IsNullOrEmpty(loginErrorMessage))
                            {
                                <p class="text-danger">@loginErrorMessage</p>
                            }
                            <div class="auth-options">
                                <label class="remember-option">
                                    <input type="checkbox" /> Keep me signed in
                                </label>
                                <a class="auth-text-button" href="/sign-in">Forgot password?</a>
                            </div>

                            <button class="auth-submit" type="submit">
                                Sign in to Recipefy
                                <Icon Name="ArrowRight" Size="16" />
                            </button>
                        
                    </EditForm>}

                <p class="auth-switch">@(IsSignUp ? "Already have an account?" : "New to Recipefy?") <a href="@(IsSignUp ? "/sign-in" : "/sign-up")">@(IsSignUp ? "Sign in" : "Create an account")</a></p>
                <p class="auth-terms">By continuing, you agree to our <a href="#terms">Terms</a> and <a href="#privacy">Privacy Policy</a>.</p>
            </div>
        </section>
        <aside class="auth-aside">
            <div class="auth-aside-copy">
                <span class="auth-quote-mark">“</span>
                <blockquote>Good food is all the sweeter when shared with good people.</blockquote>
                <p>A little more joy, one recipe at a time.</p>
                <div class="auth-ornament"><span></span><span></span><span></span></div>
            </div>
            <div class="auth-aside-foot"><span>YOUR KITCHEN, YOUR WAY</span><span>EST. WITH LOVE</span></div>
        </aside>
    </div>
</main>

@code {
    [Parameter] public bool IsSignUp { get; set; }
    [SupplyParameterFromForm(FormName = "SignUpForm")]
    private RegisterModel registerModel { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "SignInForm")]
    private LoginModel loginModel { get; set; } = default!;

    private string? loginErrorMessage;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        registerModel ??= new();
        loginModel ??= new();
    }
    private async Task RegisterUser()
    {
        var user = new IdentityUser
        {
            UserName = registerModel.Username,
            Email = registerModel.Email
        };

        var result = await UserManager.CreateAsync(
            user,
            registerModel.Password
        );

        if (result.Succeeded)
        {
            Navigation.NavigateTo("/sign-in");
        }
        else
        {
            errorMessage = string.Join(
                ", ",
                result.Errors.Select(error => error.Description)
            );
        }
    }
    private async Task LoginUser()
{
    // Buscar al usuario por su correo electrónico
    var user = await UserManager.FindByEmailAsync(loginModel.Email);

    if (user is null)
    {
        loginErrorMessage = "Invalid email or password.";
        return;
    }

    // Comprobar la contraseña e iniciar sesión
    var result = await SignInManager.PasswordSignInAsync(
        user,
        loginModel.Password,
        isPersistent: false,
        lockoutOnFailure: false
    );

    if (result.Succeeded)
    {
        Navigation.NavigateTo("/dashboard");
    }
    else
    {
        loginErrorMessage = "Invalid email or password.";
    }
}

}
